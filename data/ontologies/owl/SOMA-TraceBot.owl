    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#AgentRole -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#AgentRole">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ActorRole"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#CausativeRole -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CausativeRole"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#ColorRegion -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#ColorRegion"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Container -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Container">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ContainerRole"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Destination -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Destination">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DestinationRole"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#EventAdjacentRole -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#EventAdjacentRole"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Fluid -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Fluid"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#GetTaskParameter -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#GetTaskParameter"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Localization -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Localization"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Location -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Location"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#LookingFor -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#LookingFor"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Material -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Material"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Origin -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Origin">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#SourceRole"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Patient -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Patient">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#PatientRole"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#PickingUp -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#PickingUp"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Planning -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Planning"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Pushing -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Pushing"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Reaching -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Reaching"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Reasoning -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Reasoning"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Receiver -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Receiver"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#ResourceRole -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#ResourceRole"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Restrictor -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Restrictor"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Shape -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Shape"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Supporter -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Supporter">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#SupportRole"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Transporting -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Transporting"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#3DPosition -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#3DPosition"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#6DPose -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#6DPose"/>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#DesignedArtifact -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#DesignedArtifact">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasLocalization"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Pose"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject"/>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Region -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Region"/>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ActorRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ActorRole">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#CausativeRole"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#CanisterGraspInfo -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#CanisterGraspInfo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasCustomGraspTypeValue"/>
                                <owl:hasValue></owl:hasValue>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspTypeValue"/>
                                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#unsignedInt">2</owl:hasValue>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMotionDirection"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Restriction>
