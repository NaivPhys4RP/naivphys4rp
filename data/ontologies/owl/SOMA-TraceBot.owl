<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/smile/ontologies/2022/2/TraceBot"
     xml:base="http://www.semanticweb.org/smile/ontologies/2022/2/TraceBot"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:SOMA="http://www.ease-crc.org/ont/SOMA.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot">
        <owl:imports rdf:resource="http://www.ease-crc.org/ont/SOMA.owl"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2002/07/owl#qualifiedCardinality -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#qualifiedCardinality"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#array_string -->

    <rdfs:Datatype rdf:about="http://www.ease-crc.org/ont/SOMA.owl#array_string"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#hasLocalization -->

    <owl:ObjectProperty rdf:about="http://www.ease-crc.org/ont/SOMA.owl#hasLocalization"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#hasSpaceRegion -->

    <owl:ObjectProperty rdf:about="http://www.ease-crc.org/ont/SOMA.owl#hasSpaceRegion"/>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality"/>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspInfo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspInfo">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspType">
        <rdfs:subPropertyOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasSpaceRegion"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMaterial -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMaterial">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMotionDirection -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMotionDirection">
        <rdfs:subPropertyOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasSpaceRegion"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo"/>
        <rdfs:range rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#3DPosition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_pose -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_pose">
        <rdfs:subPropertyOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasSpaceRegion"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Pose"/>
        <rdfs:range rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#6DPose"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#hasPositionData -->

    <owl:DatatypeProperty rdf:about="http://www.ease-crc.org/ont/SOMA.owl#hasPositionData"/>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRegionDataValue -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRegionDataValue"/>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasCustomGraspTypeValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasCustomGraspTypeValue">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRegionDataValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspTypeValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspTypeValue">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRegionDataValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_been_verified -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_been_verified">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_feasibility_been_verified -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_feasibility_been_verified">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_feasibility_recovery_explanation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_feasibility_recovery_explanation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_feasibility_verification_confidence -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_feasibility_verification_confidence">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_feasibility_verification_explanation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_feasibility_verification_explanation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_nonverbal_feasibility_verification_explanation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_nonverbal_feasibility_verification_explanation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_nonverbal_verification_explanation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_nonverbal_verification_explanation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_recovery_explanation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_recovery_explanation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_verification_confidence -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_verification_confidence">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_verification_explanation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_verification_explanation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#is_action_feasible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#is_action_feasible">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#is_feasibility_verification_postponed -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#is_feasibility_verification_postponed">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#is_verification_postponed -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#is_verification_postponed">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


