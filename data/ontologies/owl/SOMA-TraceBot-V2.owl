    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ContainerSizeRegion -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ContainerSizeRegion">
