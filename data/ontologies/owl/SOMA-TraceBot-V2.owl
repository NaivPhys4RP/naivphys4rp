<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/smile/ontologies/2022/2/TraceBot"
     xml:base="http://www.semanticweb.org/smile/ontologies/2022/2/TraceBot"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:SOMA="http://www.ease-crc.org/ont/SOMA.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot">
        <owl:imports rdf:resource="http://www.ease-crc.org/ont/SOMA.owl"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2002/07/owl#qualifiedCardinality -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#qualifiedCardinality"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspInfo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspInfo">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspType">
        <rdfs:subPropertyOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasSpaceRegion"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMaterial -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMaterial">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMotionDirection -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMotionDirection">
        <rdfs:subPropertyOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasSpaceRegion"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo"/>
        <rdfs:range rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#3DPosition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_pose -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_pose">
        <rdfs:subPropertyOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasSpaceRegion"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Pose"/>
        <rdfs:range rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#6DPose"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasCustomGraspTypeValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasCustomGraspTypeValue">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRegionDataValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspTypeValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspTypeValue">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRegionDataValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#DesignedArtifact -->

    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#DesignedArtifact">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasLocalization"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Pose"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#AirVent -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#AirVent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotComponent"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Bottle -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Bottle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotContainer"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#CanisterAirVent -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#CanisterAirVent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#AirVent"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#CanisterGraspInfo -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#CanisterGraspInfo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasCustomGraspTypeValue"/>
                                <owl:hasValue></owl:hasValue>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspTypeValue"/>
                                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#unsignedInt">2</owl:hasValue>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMotionDirection"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasPositionData"/>
                        <owl:hasValue>0.14 0.36 0.78</owl:hasValue>
                    </owl:Restriction>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#has_pose"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasPositionData"/>
                        <owl:hasValue>0.10 0.12 -0.33 0.02 0.14 0.87 -0.15</owl:hasValue>
                    </owl:Restriction>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ComputingGraspTrajectory -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ComputingGraspTrajectory">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#GetTaskParameter"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ComputingLiftTrajectory -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ComputingLiftTrajectory">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#GetTaskParameter"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ConfiguringGrasp -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#ConfiguringGrasp">
