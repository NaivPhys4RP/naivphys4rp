    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotContainer -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotContainer">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedContainer"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotFluid -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotFluid">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Fluid"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotTool -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotTool">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedTool"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#FittingInsertableIntoInsertee -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#FittingInsertableIntoInsertee">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Transporting"/>
        <rdfs:comment rdf:datatype="http://www.ease-crc.org/ont/SOMA.owl#array_string">Picking an object up from one location (Insertable) and inserting into another one (Insertee)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspInfo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspPose"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasMotionDirection"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#MotionDirection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspPose -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspPose">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Pose"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#GraspType">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Region"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasCustomGraspTypeValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#hasGraspTypeValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Inserting -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#Inserting">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Pushing"/>
    </owl:Class>
    


