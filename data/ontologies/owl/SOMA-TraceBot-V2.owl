    </owl:Class>
    


    <!-- http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotComponent -->

    <owl:Class rdf:about="http://www.semanticweb.org/smile/ontologies/2022/3/TraceBot#DesignedTracebotComponent">
