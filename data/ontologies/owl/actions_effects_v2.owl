<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/cea-rg/actions"
     xml:base="http://www.semanticweb.org/cea-rg/actions"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:tra="http://www.semanticweb.org/cea-rg/actions#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/cea-rg/actions"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/cea-rg/actions#has1stParameter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#has1stParameter">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#is1stParameterOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Skill"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Material"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#has2ndParameter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#has2ndParameter">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#is2ndParameterOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Skill"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Material"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasEffect -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasEffect">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Skill"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Effect"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasInterface -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasInterface"/>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasProperty -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasProperty">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#is1stParameterOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#is1stParameterOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Material"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Skill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#is2ndParameterOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#is2ndParameterOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Material"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Skill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#isAttachedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#isAttachedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Material"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Material"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#isBelow -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#isBelow">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#isOn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#isIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#isIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#isInsertedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#isInsertedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#isInsertedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#isOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#isOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Material"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cea-rg/actions#Material"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasHeight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasHeight">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasLength -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasLength">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasRadius -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasRadius">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasShapeType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasShapeType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasStatement -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasStatement">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#hasWidth -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#hasWidth">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#isAvailable -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#isAvailable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#isDetected -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cea-rg/actions#isDetected">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cea-rg/actions#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/cea-rg/actions#Add -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#Add">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#Function"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#AddInsert -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#AddInsert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#Add"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#AddPlace -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#AddPlace">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#Add"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#Bottle -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#Bottle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#NamedObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasInterface"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cea-rg/actions#BottleGraspableInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasInterface"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cea-rg/actions#BottleInserteeInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasInterface"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cea-rg/actions#BottlePlaceableInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasHeight"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasRadius"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasShapeType"/>
                <owl:hasValue>Cylindrical</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#BottleGraspableInterface -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#BottleGraspableInterface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#GraspableInterface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasHeight"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasRadius"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasShapeType"/>
                <owl:hasValue>Cylindrical</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#isAvailable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#BottleInserteeInterface -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#BottleInserteeInterface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#InserteeInterface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasHeight"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasRadius"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasShapeType"/>
                <owl:hasValue>Cylindrical</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#isAvailable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#BottlePlaceableInterface -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#BottlePlaceableInterface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#PlaceableInterface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasRadius"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasShapeType"/>
                <owl:hasValue>Circular</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#isAvailable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#Canister -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#Canister">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#NamedObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasInterface"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cea-rg/actions#CanisterGraspableInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasInterface"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cea-rg/actions#CanisterInsertableInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasInterface"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cea-rg/actions#CanisterPlaceableInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasHeight"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasRadius"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasShapeType"/>
                <owl:hasValue>Cylindrical</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#CanisterGraspableInterface -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#CanisterGraspableInterface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#GraspableInterface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasHeight"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">9.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasRadius"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasShapeType"/>
                <owl:hasValue>Cylindrical</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#isAvailable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#CanisterInsertableInterface -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#CanisterInsertableInterface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#InsertableInterface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasHeight"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasRadius"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasShapeType"/>
                <owl:hasValue>Cylindrical</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#isAvailable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#CanisterPlaceableInterface -->

    <owl:Class rdf:about="http://www.semanticweb.org/cea-rg/actions#CanisterPlaceableInterface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cea-rg/actions#PlaceableInterface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cea-rg/actions#hasRadius"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
