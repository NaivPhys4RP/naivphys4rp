    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/cea-rg/actions#add_insert -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#add_insert">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#AddInsert"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isIn ?P2</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#add_place -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#add_place">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#AddPlace"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isOn ?P2</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#none -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#none"/>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#remove_grasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#remove_grasp">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#RemoveGrasp"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isIn ?R2</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isOn ?R1</tra:hasStatement>
        <rdfs:comment>We remove from the kb the fact that the object grasped is on otehr objects since it is in the robot manipulator.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#remove_insert -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#remove_insert">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#RemoveInsert"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isAttachedTo ?R1</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?R1 isAttachedTo ?P1</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#remove_place -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#remove_place">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#RemovePlace"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isAttachedTo ?R1</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?R1 isAttachedTo ?P1</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#request_grasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#request_grasp">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#RequestGrasp"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isIn ?R2</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isOn ?R1</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#request_insert -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#request_insert">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#RequestInsert"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isAttachedTo ?R1</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#request_place -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#request_place">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#RequestPlace"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isAttachedTo ?R1</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#update_detect -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#update_detect">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#UpdateDetect"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P isDetected true</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#update_grasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#update_grasp">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#UpdateGrasp"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 hasFreeInterfaceGraspable false</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 hasFreeInterfaceInsertable true</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 hasFreeInterfacePlaceable true</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 isAttachedTo ?P2</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P2 isAvailable false</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?R2 hasFreeInterfaceInsertee true</tra:hasStatement>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/cea-rg/actions#update_insert -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cea-rg/actions#update_insert">
        <rdf:type rdf:resource="http://www.semanticweb.org/cea-rg/actions#UpdateInsert"/>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 hasFreeInterfaceGraspable true</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P1 hasFreeInterfaceInsertable false</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?P2 hasFreeInterfaceInsertee false</tra:hasStatement>
        <tra:hasStatement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">?R1 isAvailable true</tra:hasStatement>
    </owl:NamedIndividual>
    


