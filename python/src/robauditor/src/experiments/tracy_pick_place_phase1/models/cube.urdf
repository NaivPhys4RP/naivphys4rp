<?xml version="1.0"?>
<robot name="phase1_cube">
  <!-- Standalone object model. Size: 40 mm cube; mass: 80 g. -->
  <link name="cube_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000213333" ixy="0" ixz="0"
               iyy="0.0000213333" iyz="0"
               izz="0.0000213333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="phase1_red">
        <color rgba="0.85 0.12 0.08 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </collision>
  </link>
</robot>
